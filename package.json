{
  "name": "mirage-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc -b packages/core packages/catalog-basic packages/react packages/server packages/vite packages/cli && cp packages/catalog-basic/src/styles.css packages/catalog-basic/dist/",
    "typecheck": "pnpm build && tsc -p examples/greenhouse",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "eval": "node packages/cli/dist/bin.js eval --root examples/greenhouse",
    "eval:record": "node packages/cli/dist/bin.js eval --root examples/greenhouse --runs 1 --record e2e/fixtures/greenhouse.recording.json",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ai": "^7.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "zod": "^4.1.0"
  }
}
