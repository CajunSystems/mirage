{
  "name": "@cajunsystems/mirage-react",
  "version": "0.1.0",
  "description": "Mirage React renderer: renders Mirage specs, runs data sources and actions, and streams generated pages.",
  "keywords": [
    "mirage",
    "generative-ui",
    "react",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "CajunSystems",
  "homepage": "https://github.com/CajunSystems/mirage/tree/main/packages/react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CajunSystems/mirage.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/CajunSystems/mirage/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@cajunsystems/mirage-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-router": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "react": "^19.1.0",
    "react-router": "^7.9.0",
    "zod": "^4.1.0"
  }
}
