{
  "name": "@cajunsystems/mirage-vite",
  "version": "0.1.0",
  "description": "Mirage Vite plugin: file-based routes, dev middleware, HMR for intents, and the production server.",
  "keywords": [
    "mirage",
    "generative-ui",
    "react",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "CajunSystems",
  "homepage": "https://github.com/CajunSystems/mirage/tree/main/packages/vite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CajunSystems/mirage.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/CajunSystems/mirage/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./client": {
      "types": "./client.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "client.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@cajunsystems/mirage-core": "workspace:*",
    "@cajunsystems/mirage-server": "workspace:*",
    "hono": "^4.9.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "vite": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "ai": "^7.0.0",
    "vite": "^7.1.0",
    "zod": "^4.1.0"
  }
}
