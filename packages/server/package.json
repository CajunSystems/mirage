{
  "name": "@cajunsystems/mirage-server",
  "version": "0.0.0",
  "description": "Mirage server: generates specs from intents with any AI SDK model, plus the tool endpoint, caching and locking.",
  "keywords": [
    "mirage",
    "generative-ui",
    "react",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "CajunSystems",
  "homepage": "https://github.com/CajunSystems/mirage/tree/main/packages/server#readme",
