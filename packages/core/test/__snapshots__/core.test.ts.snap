        "text": {
          "type": "string",
        },
      },
      "required": [
        "text",
      ],
      "type": "object",
    },
  },
  {
    "container": false,
    "description": "Tabular data.",
    "name": "Table",
    "props": {
      "properties": {
        "columns": {
          "items": {
            "properties": {
              "key": {
                "type": "string",
              },
              "label": {
                "type": "string",
              },
            },
            "required": [
              "key",
              "label",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "onRowClick": {
          "x-mirage": "action",
        },
        "rows": {
          "x-mirage": "binding",
        },
      },
      "required": [
        "rows",
        "columns",
      ],
      "type": "object",
    },
  },
  {
    "container": false,
    "description": "A button.",
    "name": "Button",
    "props": {
      "properties": {
        "label": {
          "type": "string",
        },
        "onPress": {
          "x-mirage": "action",
        },
      },
      "required": [
        "label",
        "onPress",
      ],
      "type": "object",
    },
  },
]
`;

