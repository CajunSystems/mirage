{
  "name": "@cajunsystems/mirage-cli",
  "version": "0.1.0",
  "description": "The mirage CLI: dev, build, lock, regen, eject, eval and init.",
  "keywords": [
    "mirage",
    "generative-ui",
    "react",
    "llm",
    "ai"
  ],
  "license": "Apache-2.0",
  "author": "CajunSystems",
  "homepage": "https://github.com/CajunSystems/mirage/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CajunSystems/mirage.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/CajunSystems/mirage/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mirage": "./dist/bin.js"
  },
  "files": [
