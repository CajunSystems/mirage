    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@cajunsystems/mirage-core": "workspace:*",
    "@cajunsystems/mirage-server": "workspace:*",
    "@cajunsystems/mirage-vite": "workspace:*",
    "cac": "^6.7.14",
    "diff": "^8.0.0"
  },
  "peerDependencies": {
    "ai": "^7.0.0",
    "vite": "^7.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "ai": "^7.0.0",
    "vite": "^7.1.0",
    "zod": "^4.1.0"
  }
}
