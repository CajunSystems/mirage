// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`eject > renders the same DOM as the spec renderer ('home') 1`] = `"<div class="mi-stack mi-gap-lg"><div class="mi-row mi-gap-md mi-align-between"><h1 class="mi-heading">Today</h1><button type="button" class="mi-button mi-button-secondary">All plants</button></div><div class="mi-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));"><div class="mi-stat"><div class="mi-stat-label">Plants</div><div class="mi-stat-value">5</div></div><div class="mi-stat"><div class="mi-stat-label">Need water</div><div class="mi-stat-value">2</div><div class="mi-stat-hint">Due today or overdue</div></div><div class="mi-stat"><div class="mi-stat-label">Locations</div><div class="mi-stat-value">4</div></div></div><section class="mi-card"><h3 class="mi-card-title">Needs water</h3><table class="mi-table"><thead><tr><th>Plant</th><th>Location</th><th>Days since watered</th></tr></thead><tbody><tr class="mi-clickable"><td>Fiddle-leaf fig</td><td>Bench A</td><td>12</td></tr><tr class="mi-clickable"><td>Boston fern</td><td>Misting tent</td><td>4</td></tr></tbody></table></section></div>"`;

exports[`eject > renders the same DOM as the spec renderer ('plant') 1`] = `"<div class="mi-stack mi-gap-lg"><button type="button" class="mi-button mi-button-secondary">← All plants</button><div class="mi-row mi-gap-md mi-align-between"><div class="mi-stack mi-gap-sm"><h1 class="mi-heading">Basil</h1><p class="mi-text mi-tone-muted">Ocimum basilicum</p><span class="mi-badge mi-badge-success">OK</span></div><button type="button" class="mi-button mi-button-primary">Mark as watered</button></div><div class="mi-grid" style="grid-template-columns: repeat(3, minmax(0, 1fr));"><section class="mi-card"><h3 class="mi-card-title">Soil</h3><div class="moisture"><div class="moisture-label"><span>Soil moisture</span><span>70%</span></div><div class="moisture-track" role="meter" aria-valuemin="0" aria-valuemax="100" aria-valuenow="70" aria-label="Soil moisture"><div class="moisture-fill moisture-ok" style="width: 70%;"></div></div></div></section><div class="mi-stat"><div class="mi-stat-label">Water every</div><div class="mi-stat-value">2</div><div class="mi-stat-hint">days</div></div><div class="mi-stat"><div class="mi-stat-label">Days since watered</div><div class="mi-stat-value">1</div><div class="mi-stat-hint">2026-09-29</div></div></div><section class="mi-card"><h3 class="mi-card-title">About</h3><p class="mi-text mi-tone-default">Herb shelf</p><p class="mi-text mi-tone-muted">—</p></section></div>"`;

exports[`eject > renders the same DOM as the spec renderer ('plants') 1`] = `"<div class="mi-stack mi-gap-md"><div class="mi-row mi-gap-md mi-align-between"><h1 class="mi-heading">Plants</h1><button type="button" class="mi-button mi-button-primary">New plant</button></div><label class="mi-field"><span class="mi-field-label">Search</span><input class="mi-input" placeholder="Name, species or location" type="text" value=""></label><table class="mi-table"><thead><tr><th>Name</th><th>Species</th><th>Location</th><th>Water</th></tr></thead><tbody><tr class="mi-clickable"><td>Monstera</td><td>Monstera deliciosa</td><td>Bench A</td><td>OK</td></tr><tr class="mi-clickable"><td>Fiddle-leaf fig</td><td>Ficus lyrata</td><td>Bench A</td><td>Needs water</td></tr><tr class="mi-clickable"><td>Basil</td><td>Ocimum basilicum</td><td>Herb shelf</td><td>OK</td></tr><tr class="mi-clickable"><td>Aloe</td><td>Aloe vera</td><td>Window</td><td>OK</td></tr><tr class="mi-clickable"><td>Boston fern</td><td>Nephrolepis exaltata</td><td>Misting tent</td><td>Needs water</td></tr></tbody></table></div>"`;
